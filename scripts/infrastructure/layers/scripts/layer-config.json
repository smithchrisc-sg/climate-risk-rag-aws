{
  "layers": {
    "database-core-layer": {
      "description": "Core database utilities with PostgreSQL connection pooling",
      "compatible_runtimes": ["python3.11"],
      "aws_layer_name": "database-core-layer-v3",
      "required_methods": [
        "set_processing_status",
        "get_document",
        "add_or_update_document"
      ]
    },
    "opensearch-layer": {
      "description": "OpenSearch client and utilities",
      "compatible_runtimes": ["python3.11"],
      "aws_layer_name": "opensearch-layer",
      "required_methods": []
    }
  },
  "build_settings": {
    "default_profile": "solve-global",
    "default_region": "us-east-1",
    "exclude_patterns": [
      "__pycache__",
      "*.pyc",
      "*.pyo",
      ".DS_Store",
      "*.dist-info",
      ".pytest_cache",
      "tests/"
    ]
  }
}
