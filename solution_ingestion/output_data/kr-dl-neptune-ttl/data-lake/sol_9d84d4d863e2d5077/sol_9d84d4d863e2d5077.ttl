sg:Org_pub_singapores_national_water_agency a org:Organization ;
    skos:prefLabel "PUB, Singapore’s National Water Agency" ;
    schema:contactPoint sg:Contact_pub_singapores_national_water_agency .

sg:Contact_pub_singapores_national_water_agency a schema:ContactPoint ;
    schema:email "A central PUB email channel should be used to reference 'Coastal and Flood Protection Fund' and 'Coastal Protection Department.' If a web form is preferred, submit via PUB’s official contact portal." ;
    schema:telephone "+65 1800 2255 782" .

sg:Org_ministry_of_finance_mof a org:Organization ;
    skos:prefLabel "Ministry of Finance (MOF)" ;
