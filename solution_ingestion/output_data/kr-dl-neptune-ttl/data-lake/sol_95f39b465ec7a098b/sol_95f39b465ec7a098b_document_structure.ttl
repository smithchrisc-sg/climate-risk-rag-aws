sg:Chunk_sol_ca8dc89b014e21f93_highlights a sgd:Section ;
    dcterms:description "HMO membership can complement the Philippine Health Insurance Corporation's (PhilHealth) plan, offering an additional layer of financial security. When a PhilHealth member requires hospitalization, PhilHealth may cover between 15% to 30% of their bills, depending on the membership status. The remaining balance is typically covered by the individual's chosen HMO plan. However, it is important to note that HMO benefits are generally linked to employment and are available to individuals under 65 years old." ;
    dcterms:isPartOf sg:Document_sol_95f39b465ec7a098b ;
    dcterms:title "Key Highlights" ;
    sgd:hasParent sg:Document_sol_95f39b465ec7a098b ;
