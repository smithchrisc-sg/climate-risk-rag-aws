sg:Document_sol_example_123abc456xyz a sgd:Solution ; # Ontology: sgd:Solution rdfs:subClassOf sgd:Document
    dcterms:created "2025-09-24" ; # From CSV: First entry from 'Date Added', converted to ISO8601
    dcterms:description "The Disaster Recovery Funding Arrangements (DRFA) is Australia's primary national funding mechanism for disaster relief and recovery, jointly financed by the Commonwealth and state/territory governments." ; # First sentence of the 'Description' column text
    dcterms:identifier "sol_example_123abc456xyz" ; # DocumentID
    # These URIs for the orgs will have to be repeatably built by our URI Minting facility - For now, we have look ups "organizations_complete.ttl"
    dcterms:publisher sg:Org_state_governments_australia ; # First org found in the public org cell, or if empty, first in international org cell, or if empty, first in private orgs. If none, skip this row.
    # Note that, for example, this one is "State Governments" in the list, so we have qualified using the "Country" value
    sg:associatedOrganization # This is all the organizations, public, international, private, including the first one that we use for publisher.
        # Public Organizations
        sg:Org_state_governments_australia, 
        sg:Org_wa_department_of_fire_and_emergency_services_dfes_australia,
        sg:Org_wa_department_of_primary_industries_and_regional_development_dpird_australia,
        sg:Org_government_of_tasmania_australia, 
        sg:Org_resilience_and_recovery_tasmania_australia,
        sg:Org_cairns_regional_council_australia,

        # International Organizations - only value NIL which is skipped (same as N/A, or <empty>)

        # Private Orgs
        sg:Org_geo_design_pty_ltd,
        sg:Org_geo_construct_pty_ltd,
        sg:Org_saxon_drilling_pty_ltd,
        sg:Org_ets_geotechnical_pty_ltd,
        sg:Org_mal_engineers_pty_ltd,
        sg:Org_3d_civil_pty_ltd ;

    sg:riskType sg:RiskType_natural_catastrophe ; # From 'Type of Risk' column, canonical IRIs defined in "vocabulary_concepts.ttl"
    sg:solutionType # From 'Type of Solution' column, canonical IRIs defined in "vocabulary_concepts.ttl"
        sg:SolutionType_risk_financing,
        sg:SolutionType_risk_reduction ;
    sg:theme # From 'Theme' column, canonical IRIs defined in "vocabulary_concepts.ttl"
        sg:Theme_collaboration,
        sg:Theme_regulation ;

    sg:implementationYear  # From 'Year of Implementation' column, expressed as an xsd:gYear literal
        "2023"^^xsd:gYear,
        "2022"^^xsd:gYear ;

    dcterms:source <https://www.cairns.qld.gov.au/__data/assets/pdf_file/0006/675645/Clause-No.-21.pdf> ; # From CSV: First entry from 'Organizational Sources' or if empty, first entry from 'Other Sources'
    dcterms:references <https://www.dpird.wa.gov.au/siteassets/documents/grants/drfa/drfa_wa_information---measures-to-assist-primary-producers-april-2025.pdf>, # From CSV, subsequent entries from 'Organizational Sources' and/or 'Other Sources'
    dcterms:references <https://www.dpac.tas.gov.au/divisions/resilience-recovery/recovery_funding_arrnagements>,
    dcterms:references <https://minister.homeaffairs.gov.au/JennyMcAllister/Pages/support-for-tas-storm-flood-affected-communities.aspx>, 
    dcterms:references <https://www.fire.tas.gov.au/wp-content/uploads/2025/06/V1.2_DPFEM-TEMA-Issue-2-accessible.pdf>,
    dcterms:spatial gn:2077456 ; # Australia  # From CSV: 'Country' column value mapped to GeoNames URI
    dcterms:title "Disaster Recovery Funding Arrangements (DRFA)" ; # From CSV: First entry from 'Name'
    sgd:firstChild sg:Chunk_sol_example_123abc456xyz_0001 ;
    sgd:hasChild sg:Chunk_sol_example_123abc456xyz_0001, # Introduction Section from the pseudo document
        sg:Chunk_sol_example_123abc456xyz_0003, # Description Section from the pseudo document
        sg:Chunk_sol_example_123abc456xyz_0006, # Key Highlights Section from the pseudo document 
        sg:Chunk_sol_example_123abc456xyz_0009 ; # Results Section from the pseudo document
    sgd:lastChild sg:Chunk_sol_example_123abc456xyz_0007 ;
    sgm:processingTimestamp "2025-11-04T11:55:14.437533+00:00"^^xsd:dateTime . # Timestamp

