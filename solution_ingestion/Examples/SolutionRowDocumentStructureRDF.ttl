# Parsed from 'Contact Information'
sg:Org_state_governments a org:Organization ; # As noted above, need efficient, repeatable URI minting for orgs, contact points
  skos:prefLabel "State Governments" ;
  schema:contactPoint sg:Contact_state_governments .

sg:Contact_state_governments a schema:ContactPoint ;
  schema:email "info@qra.qld.gov.au" ;
  schema:telephone "1800 110 841" .

sg:Org_dfes-wa a org:Organization ;
  skos:prefLabel "WA Department of Fire and Emergency Services (DFES)" ;
  schema:contactPoint sg:Contact_dfes-wa .

sg:Contact_dfes-wa a schema:ContactPoint ;
  schema:email "drfawa@dfes.wa.gov.au" ;
  schema:telephone "1800 920 659" .

sg:Org_dpird-wa a org:Organization ;
  skos:prefLabel "WA Department of Primary Industries and Regional Development (DPIRD)" ;
  schema:contactPoint sg:Contact_dpird-wa .

sg:Contact_dpird-wa a schema:ContactPoint ;
  schema:email "RuralBusiness.Developmentunit@dpird.wa.gov.au" ;
  schema:telephone "+61 1300 374 731" .

sg:Org_tas-gov a org:Organization ;
  skos:prefLabel "Government of Tasmania" ;
  schema:contactPoint sg:tas-gov .

sg:tas-gov a schema:ContactPoint ;
  schema:telephone "1300 135 513" .

