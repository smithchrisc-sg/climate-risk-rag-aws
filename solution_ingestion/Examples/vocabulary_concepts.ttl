@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sg: <http://solve.global/knowledge-commons/> .

# Concept Schemes

sg:RiskType a rdf:Class ;
    rdfs:label "Risk Type" ;
    rdfs:subClassOf skos:Concept .

sg:SolutionType a rdf:Class ;
    rdfs:label "Solution Type" ;
    rdfs:subClassOf skos:Concept .

sg:Theme a rdf:Class ;
    rdfs:label "Theme" ;
    rdfs:subClassOf skos:Concept .

